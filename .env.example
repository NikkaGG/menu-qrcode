DATABASE_URL=replace-with-database-url
STATS_PASSWORD=replace-with-stats-password
STATS_SESSION_SECRET=replace-with-32+ random characters
ADMIN_LOGIN=replace-with-admin-login
ADMIN_PASSWORD_HASH=replace-with-generated scrypt hash
ADMIN_SESSION_SECRET=replace-with-32+ random characters
APP_URL=https://your-app.example.com

# Platform/local runtime control.
# Vercel supplies NODE_ENV=production automatically; users must not override it in Vercel.
NODE_ENV=development

# Local seed command only, never configure in Vercel production.
# Set SEED_STAGE05_CONFIRM to I_UNDERSTAND_THIS_ADDS_TEST_DATA and SEED_STAGE05_ALLOW_HOSTED to 1 only for an intentional local command.
SEED_STAGE05_CONFIRM=
SEED_STAGE05_ALLOW_HOSTED=0
