{
  "name": "sushi-crazy-menu",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-server.cjs",
    "build:pages": "node scripts/build-pages.cjs",
    "test:pages": "node --test tests/pages.test.cjs",
    "test": "node --test tests/operations.test.cjs",
    "test:browser": "node tests/operations.browser.cjs",
    "test:controls": "node tests/operations.controls.cjs",
    "test:palette": "node tests/operations.palette.cjs",
    "test:postgres": "node tests/product.postgres.cjs",
    "test:product": "node tests/product.browser.cjs",
    "test:guest": "node --test tests/guest-live.test.cjs && node tests/guest-tracker.browser.cjs && node tests/guest-tracker-interactions.browser.cjs",
    "test:production": "node tests/product.production.cjs",
    "build:excel": "esbuild scripts/excel-entry.js --bundle --minify --format=iife --outfile=vendor/read-excel-file.js",
    "test:legacy": "node --test tests/regression.test.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "axe-core": "4.13.0",
    "esbuild": "0.28.2",
    "puppeteer-core": "25.3.0",
    "typescript": "5.9.3",
    "wrangler": "4.147.0",
    "ws": "8.22.0"
  },
  "dependencies": {
    "read-excel-file": "9.3.10"
  }
}
